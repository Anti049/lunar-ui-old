{
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"endOfLine": "auto",
	"printWidth": 100,
	"plugins": ["prettier-plugin-svelte", "prettier-plugin-tailwindcss"],
	"overrides": [
		{
			"files": "*.svelte",
			"options": {
				"parser": "svelte"
			}
		}
	],
	"tailwindStylesheet": "./prettier-tailwind.css",
	"tailwindFunctions": ["clsx", "cn"]
}
