{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"rootDir": ".",
		"outDir": "./dist",
		"declaration": true,
		"sourceMap": false,
		"allowJs": false,
		"checkJs": false,
		"types": ["node"]
	},
	/*
		Entry points only. functions/ holds both shipped runtime (addPrefix,
		nestCssLayers, generateTheme) and the build-time compiler (build.ts and its
		extractors), so globbing it would emit the compiler into dist. tsc follows
		imports from the entries instead, which ships exactly what the runtime
		reaches -- no hand-maintained list to fall out of date.
	*/
	"include": ["index.ts", "theme.ts", "themes.ts", "types.ts", "generated/**/*.ts"]
}
